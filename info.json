{
  "id": "raylea.game-guide",
  "name": "游戏攻略",
  "version": "0.4.0",
  "manifest_version": "4",
  "license": "MIT",
  "min_core_version": "0.4.0",
  "metadata": {
    "description": "查询《崩坏：星穹铁道》角色攻略图",
    "author": "raylea",
    "repo": "https://github.com/RayleaBot/game-guide",
    "keywords": ["guide", "render", "honkai-star-rail"]
  },
  "concurrency": 3,
  "events": ["message.group", "message.private", "plugin.started", "bot.identity.changed"],
  "commands": [
    {
      "id": "game-guide",
      "name": "游戏攻略",
      "description": "查询《崩坏：星穹铁道》角色攻略图",
      "usage": "/游戏攻略 <角色名>",
      "permission": "everyone",
      "trigger": {
        "type": "exact",
        "names": ["游戏攻略"]
      }
    },
    {
      "id": "character-guide",
      "name": "角色攻略",
      "description": "按角色名或别名查询攻略图",
      "usage": "*<角色名>攻略",
      "permission": "everyone",
      "trigger": {
        "type": "pattern",
        "pattern": "^(.+?)攻略$"
      }
    },
    {
      "id": "character-list",
      "name": "已适配角色列表",
      "description": "查看当前已适配星穹铁道攻略的全部角色",
      "usage": "*角色列表",
      "permission": "everyone",
      "trigger": {
        "type": "pattern",
        "pattern": "^角色列表$"
      }
    }
  ],
  "command_groups": [
    {
      "id": "guides",
      "title": "角色攻略",
      "commands": ["game-guide", "character-guide", "character-list"]
    }
  ],
  "help": {
    "title": "游戏攻略",
    "summary": "查询《崩坏：星穹铁道》角色攻略图"
  }
}
